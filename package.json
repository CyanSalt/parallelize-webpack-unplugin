{
  "name": "parallelize-webpack-unplugin",
  "version": "0.2.0",
  "description": "Use unplugin with thread-loader in webpack",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "prepack": "tsdown",
    "lint": "eslint --fix './**/*.{js,mjs,ts}'",
    "lint:ci": "eslint --max-warnings 0 './**/*.{js,mjs,ts}'",
    "release": "release-it"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CyanSalt/parallelize-webpack-unplugin.git"
  },
  "keywords": [
    "thread-loader",
    "unplugin",
    "webpack"
  ],
  "author": "CyanSalt",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/CyanSalt/parallelize-webpack-unplugin/issues"
  },
  "homepage": "https://github.com/CyanSalt/parallelize-webpack-unplugin#readme",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.15.0",
      "onFail": "error"
    },
    "packageManager": [
      {
        "name": "pnpm",
        "version": "^11.0.0",
        "onFail": "ignore"
      },
      {
        "name": "npm",
        "onFail": "ignore"
      }
    ]
  },
  "devDependencies": {
    "@cyansalt/eslint-config": "^4.0.0",
    "@cyansalt/tsconfig": "^3.0.2",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/node": "^24.19.2",
    "@types/webpack": "^5.28.5",
    "eslint": "^10.15.0",
    "release-it": "^21.1.2",
    "tsdown": "^0.23.7",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "unplugin": "^1.0.1"
  }
}
